# nginx-compression build glue (phase 3: real library detection).
#
# auto/detect probes libzstd and libbrotlienc with the parent repo's
# hardened patterns (bare-directory ngx_module_incs, link flags only
# through ngx_module_libs, MSVC path normalization) and — unlike the
# parent, whose modules are useless without their library — treats a
# missing library as a SHAPE, not an error: the backend roster is a
# build-time variable (NGX_HTTP_COMPRESSION_HAVE_*, written into
# ngx_auto_config.h via auto/define), the missing backend's TU
# compiles to nothing, and static sidecar serving keeps working for
# every coding. Every source file is always listed: the TUs
# self-guard, which keeps the Makefile shape identical across builds.

ngx_addon_name=ngx_http_compression_module

if test -n "$ngx_module_link"; then

    . $ngx_addon_dir/auto/detect

    ngx_module_type=HTTP_FILTER
    ngx_module_name=ngx_http_compression_module
    ngx_module_incs="$ngx_compression_incs"
    ngx_module_deps="$ngx_addon_dir/ngx_http_compression.h \
                     $ngx_addon_dir/ngx_http_compression_ae.h \
                     $ngx_addon_dir/ngx_http_compression_dict.h \
                     $ngx_addon_dir/../ngx_http_zstd_sha256.h"
    ngx_module_srcs="$ngx_addon_dir/ngx_http_compression_module.c \
                     $ngx_addon_dir/ngx_http_compression_dict.c \
                     $ngx_addon_dir/ngx_http_compression_static.c \
                     $ngx_addon_dir/ngx_http_compression_zstd.c \
                     $ngx_addon_dir/ngx_http_compression_brotli.c"
    ngx_module_libs="$ngx_compression_libs"

    . auto/module
else
    cat << END

$0: error: nginx-compression requires nginx >= 1.23.0
(list-linked headers; the header additionally enforces this with a
compile-time version check).

END
    exit 1
fi
